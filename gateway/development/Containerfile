FROM --platform=linux/amd64 docker.io/library/debian:13-slim@sha256:918311b7b6c4c6f68b232ba516584925f6c78ad82b6fd534b98979df6438e483

ENV DEBIAN_FRONTEND=noninteractive

# Without CAP_AUDIT_CONTROL, pam_loginuid cannot set host audit state or block the required hook.
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
        'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261008T000000Z trixie main' \
        'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20261008T000000Z trixie-security main' \
        > /etc/apt/sources.list \
    && printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates=20250419 \
        cockpit=337-1+deb13u2 \
        cockpit-podman=108-1 \
        dnsmasq=2.91-1+deb13u2 \
        iproute2=6.15.0-1 \
        jq=1.7.1-6+deb13u4 \
        nftables=1.1.3-1 \
        openvpn=2.6.14-1+deb13u3 \
        openssh-server=1:10.0p1-7+deb13u4 \
        openssl=3.5.7-1~deb13u3 \
        podman=5.4.2+ds1-2+b2 \
        passwd=1:4.17.4-2 \
        procps=2:4.0.4-9 \
        python3-minimal=3.13.5-1 \
        util-linux=2.41.5-0+deb13u1 \
    && rm -f /usr/sbin/policy-rc.d \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/ssh/ssh_host_* \
    && install -d -m 0755 /run/sshd /run/gateway/dns \
        /run/gateway/ssh_tun /etc/gateway/generated \
        /etc/cockpit/ws-certs.d \
    && useradd --create-home --shell /bin/bash developer \
    && useradd --system --home-dir /nonexistent --no-create-home \
        --shell /bin/sh gateway-tunnel \
    && useradd --create-home --shell /bin/bash gateway-admin \
    && usermod --append --groups root gateway-admin \
    && passwd --delete developer \
    && passwd --lock gateway-tunnel \
    && passwd --lock gateway-admin \
    && chmod 0755 /home/developer /home/gateway-admin \
    && sed -i 's/^session    required     pam_loginuid.so$/session    optional     pam_loginuid.so/' \
        /etc/pam.d/sshd \
    && printf '\nsession required pam_exec.so /usr/local/lib/gateway/ssh_tun_runtime.py pam\n' \
        >> /etc/pam.d/sshd

COPY startup.sh /usr/local/sbin/gateway-startup
COPY strict_json.py /usr/local/lib/gateway/strict_json.py
COPY host_config_validation.py /usr/local/lib/gateway/host_config_validation.py
COPY dns_records.py /usr/local/lib/gateway/dns_records.py
COPY dns_refresh.py /usr/local/lib/gateway/dns_refresh.py
COPY openvpn_runtime.py /usr/local/lib/gateway/openvpn_runtime.py
COPY remote_forwarding.py /usr/local/lib/gateway/remote_forwarding.py
COPY ssh_tun_runtime.py /usr/local/lib/gateway/ssh_tun_runtime.py
RUN chmod 0755 /usr/local/sbin/gateway-startup \
        /usr/local/lib/gateway/openvpn_runtime.py \
        /usr/local/lib/gateway/ssh_tun_runtime.py \
    && ln -s /usr/local/lib/gateway/openvpn_runtime.py /usr/local/bin/gateway-openvpn-up \
    && ln -s /usr/local/lib/gateway/openvpn_runtime.py /usr/local/bin/gateway-openvpn-down \
    && ln -s /usr/local/lib/gateway/openvpn_runtime.py /usr/local/bin/gateway-openvpn-route-up

EXPOSE 22/tcp 53/tcp 53/udp 9090/tcp
ENTRYPOINT ["/usr/local/sbin/gateway-startup"]