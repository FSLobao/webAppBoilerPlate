[Unit]
Description=Headscale and Tailscale development Gateway
After=network-online.target
Requires=gateway-vpn-return-route.service
After=gateway-vpn-return-route.service
Wants=network-online.target

[Container]
ContainerName=gateway
Image=localhost/gateway:1.0.0
HealthCmd=/usr/local/sbin/gateway-healthcheck
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=5s
HealthRetries=3
Network=podman
NetworkAlias=dev-gateway.dev.anatel
IP=CHANGE_ME_GATEWAY_IPV4
PublishPort=443:443/tcp
AddCapability=NET_ADMIN
AddDevice=/dev/net/tun:/dev/net/tun
Sysctl=net.ipv4.ip_forward=1
Volume=gateway-headscale-data:/var/lib/headscale
Volume=gateway-headplane-data:/var/lib/headplane
Volume=gateway-tailscale-data:/var/lib/tailscale
Volume=/etc/gateway-vpn/headscale.yaml:/etc/headscale/config.yaml:ro
Volume=/etc/gateway-vpn/headplane.yaml:/etc/headplane/config.yaml:ro
Volume=/etc/gateway-vpn/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=/etc/gateway-vpn/tls:/etc/gateway-vpn/tls:ro
Volume=/etc/gateway-vpn/secrets/headplane-cookie-secret:/run/secrets/headplane-cookie-secret:ro
Volume=/etc/gateway-vpn/secrets/tailscale:/run/tailscale-auth

[Service]
Restart=on-failure
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target