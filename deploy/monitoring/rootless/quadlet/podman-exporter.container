[Unit]
Description=Prometheus Podman exporter for the current rootless user
After=podman.socket
Requires=podman.socket

[Container]
Image=quay.io/navidys/prometheus-podman-exporter:v1.21.2
ContainerName=podman-exporter
Network=monitoring-rootless
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Volume=%t/podman/podman.sock:/run/podman/podman.sock:ro
UserNS=keep-id:uid=65534
SecurityLabelType=container_runtime_t
Exec=--collector.network --collector.container-stats-timeout=5s
Pull=missing

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
