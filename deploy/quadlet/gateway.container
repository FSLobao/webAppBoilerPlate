[Unit]
Description=Shared Gateway
Wants=network-online.target
After=network-online.target podman.socket
Requires=podman.socket

[Container]
ContainerName=gateway
Image=localhost/gateway:1
DNS=127.0.0.1
Volume=/var/lib/gateway/generated:/etc/gateway/generated:ro
Volume=@@AUTHORIZED_KEYS@@:/run/gateway/authorized_keys:ro
@@SSH_TUN_VOLUME@@
@@WIREGUARD_VOLUME@@
@@WIREGUARD_PEERS_VOLUME@@
Volume=/etc/gateway/cockpit-password:/run/secrets/cockpit-password:ro
Volume=/etc/gateway/tls/gateway.cert:/etc/cockpit/ws-certs.d/gateway.cert:ro
Volume=/etc/gateway/tls/gateway.key:/etc/cockpit/ws-certs.d/gateway.key:ro
Volume=/var/lib/gateway/ssh_host_keys/ssh_host_ed25519_key:/run/ssh-host-keys/ssh_host_ed25519_key:ro
Volume=/var/lib/gateway/ssh_host_keys/ssh_host_ed25519_key.pub:/run/ssh-host-keys/ssh_host_ed25519_key.pub:ro
Volume=/var/lib/gateway/dns:/run/gateway/dns:ro
Volume=/run/podman/podman.sock:/run/podman/podman.sock:ro
@@OPENVPN_VOLUME@@
Pull=never
DropCapability=NET_RAW
@@OPENVPN_RUNTIME@@
@@SSH_TUN_RUNTIME@@
@@WIREGUARD_RUNTIME@@
@@NETWORKS@@
@@PUBLISHED_PORTS@@
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock

[Service]
Restart=always
TimeoutStartSec=120
@@WIREGUARD_MODULE_LOAD@@
@@OPENVPN_HOST_ROUTE@@
@@SSH_TUN_HOST_ROUTE@@
@@WIREGUARD_HOST_ROUTE@@

[Install]
WantedBy=multi-user.target