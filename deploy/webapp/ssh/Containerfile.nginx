FROM docker.io/library/nginx:1.28-alpine

RUN apk add --no-cache bash openssh

COPY deploy/webapp/ssh/sshd_config /etc/ssh/sshd_config
COPY deploy/webapp/ssh/nginx-entrypoint.sh /usr/local/sbin/nginx-entrypoint
RUN chmod 0755 /usr/local/sbin/nginx-entrypoint \
    && install -d -o root -g root -m 0700 /root/.ssh \
    && install -d -o root -g root -m 0755 /run/sshd

EXPOSE 22 8080
ENTRYPOINT ["/usr/local/sbin/nginx-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
